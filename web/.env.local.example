# Copiar a web/.env.local y completar. NUNCA commitear el .env.local.

# El host que REALMENTE sirve el sitio, no el que redirige. El apex devuelve 308 hacia acá.
NEXT_PUBLIC_SITIO=https://www.rentora.com.ar

# Resend. El dominio tiene que estar verificado en Resend ANTES de conectar el formulario:
# con la clave cargada y el dominio sin verificar, el envío falla y el error llega tarde.
RESEND_API_KEY=
CONTACTO_DESTINO=tu-casilla@ejemplo.com
CONTACTO_REMITENTE=Rentora <hola@rentora.com.ar>

# Indexación. Solo "1" cuando rentora.com.ar sirva el sitio de verdad; si no, todo va noindex.
NEXT_PUBLIC_INDEXAR=

# Medición. Vacías = apagadas: no se carga nada y el banner de cookies no aparece.
# GA4 (G-XXXXXXXXXX) solo carga después de que el visitante acepta la analítica.
NEXT_PUBLIC_GA_ID=
# Meta Pixel (solo dígitos) solo carga después de que acepta marketing.
NEXT_PUBLIC_META_PIXEL_ID=

# Demo de 14 días por autoservicio (/probar, /demo/confirmar, /demo/lista). Apagada salvo "1":
# sin eso las rutas dan 404 y no aparece ningún CTA, ni la FAQ nueva, ni la línea de llms.txt.
# Prenderla solo cuando la demo ande en producción de punta a punta (marketing/copy-y-seo/AUDITORIA-CONVERSION.md §10).
NEXT_PUBLIC_DEMO_ACTIVA=
# La API de rentora-system, sin barra final (https://api.…). La API tiene que tener este sitio en
# RENTORA_SITIO_URL (CORS y la redirección de /demo/lista).
NEXT_PUBLIC_API_URL=
# Turnstile de Cloudflare: la site key. La secret va en la API (TURNSTILE_SECRET).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=